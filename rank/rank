# ------------------------------------------------------------------------------
# Repository Detection Engine
# ------------------------------------------------------------------------------
# Returns space-separated list of detected repo IDs
detect_active_repositories() {
    local detected=()
    local pacman_content=""
    local distro_id=""
    distro_id=$(grep -E "^ID=" /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"' || echo "arch")
    
    # Read pacman.conf and any include drop-ins
    if [[ -f "$PACMAN_CONF" ]]; then
        pacman_content=$(cat "$PACMAN_CONF" 2>/dev/null || true)
        if [[ -d "/etc/pacman.conf.d" ]]; then
            pacman_content+=$'\n'$(cat /etc/pacman.conf.d/*.conf 2>/dev/null || true)
        fi
    fi

    for entry in "${REPO_CATALOG[@]}"; do
        IFS=':' read -r repo_id subcommand filename default_max desc <<< "$entry"
        local is_active=false

        case "$repo_id" in
            arch)
                # Arch official repos (core, extra, multilib)
                if [[ "$distro_id" != "manjaro" && "$distro_id" != "artix" ]]; then
                    if echo "$pacman_content" | grep -qE "^\s*\[(core|extra|multilib)\]" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                        is_active=true
                    fi
                fi
                ;;
            manjaro)
                if [[ "$distro_id" == "manjaro" ]] || [[ -f "/etc/manjaro-release" ]]; then
                    is_active=true
                fi
                ;;
            artix)
                if [[ "$distro_id" == "artix" ]] || echo "$pacman_content" | grep -qE "^\s*\[(system|world|galaxy)\]"; then
                    is_active=true
                fi
                ;;
            chaotic-aur)
                if echo "$pacman_content" | grep -qE "^\s*\[chaotic-aur\]" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
            archlinuxcn)
                if echo "$pacman_content" | grep -qE "^\s*\[archlinuxcn\]" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
            endeavouros)
                if echo "$pacman_content" | grep -qE "^\s*\[endeavouros\]" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
            cachyos)
                if echo "$pacman_content" | grep -qE "^\s*\[cachyos" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
            blackarch)
                if echo "$pacman_content" | grep -qE "^\s*\[blackarch\]" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
            arch4edu)
                if echo "$pacman_content" | grep -qE "^\s*\[arch4edu\]" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
            arcolinux)
                if echo "$pacman_content" | grep -qE "^\s*\[arcolinux" || [[ -f "${PACMAN_D}/${filename}" ]]; then
                    is_active=true
                fi
                ;;
        esac

        if [[ "$is_active" = true ]]; then
            detected+=("$repo_id")
        fi
    done

    echo "${detected[@]}"
}

# ------------------------------------------------------------------------------
# List Command
# ------------------------------------------------------------------------------
list_repositories() {
    print_banner
    log_step "Repository Discovery Status"
    
    local detected_str
    detected_str=$(detect_active_repositories)
    read -r -a detected_list <<< "$detected_str" || true

    echo ""
    printf "  ${C_BOLD}${C_LAVENDER}%-14s %-40s %-12s %s${C_RESET}\n" "REPOSITORY" "MIRRORLIST PATH" "STATUS" "DESCRIPTION"
    printf "  ${C_SURFACE1}%-14s %-40s %-12s %s${C_RESET}\n" "──────────────" "────────────────────────────────────────" "────────────" "───────────"

    for entry in "${REPO_CATALOG[@]}"; do
        IFS=':' read -r repo_id subcommand filename default_max desc <<< "$entry"
        local is_detected=false

        for d in "${detected_list[@]}"; do
            if [[ "$d" == "$repo_id" ]]; then
                is_detected=true
                break
            fi
        done

        local file_status="${PACMAN_D}/${filename}"

        if [[ "$is_detected" = true ]]; then
            printf "  ${C_TEXT}%-14s${C_RESET} ${C_SUBTEXT1}%-40s${C_RESET} ${C_GREEN}%s %-10s${C_RESET} ${C_SUBTEXT0}%s${C_RESET}\n" "$repo_id" "$file_status" "$SYM_CHECK" "Active" "$desc"
        else
            printf "  ${C_OVERLAY1}%-14s${C_RESET} ${C_OVERLAY0}%-40s${C_RESET} ${C_OVERLAY0}%s %-10s${C_RESET} ${C_SURFACE2}%s${C_RESET}\n" "$repo_id" "$file_status" "$SYM_BULLET" "Inactive" "$desc"
        fi
    done
    echo ""
}

# ------------------------------------------------------------------------------
# Privilege Check and Auto-Elevation
# ------------------------------------------------------------------------------
ensure_privileges() {
    if [[ "$FLAG_DRY_RUN" = true ]]; then
        return 0
    fi

    if [[ $EUID -ne 0 ]]; then
        if command -v sudo >/dev/null 2>&1; then
            if ! sudo -n true 2>/dev/null; then
                log_info "Elevated privileges required to update pacman mirrorlists."
            fi
            local script_path
            script_path="$(realpath "$0" 2>/dev/null || echo "$0")"
            exec sudo -- bash "$script_path" "$@"
        else
            log_error "This script must be run as root or with sudo installed."
            exit 1
        fi
    fi
}

# ------------------------------------------------------------------------------
# Backup Management & Restoration
# ------------------------------------------------------------------------------
create_backup() {
    local target_file="$1"
    local repo_id="$2"

    if [[ "$FLAG_NO_BACKUP" = true ]] || [[ ! -f "$target_file" ]]; then
        return 0
    fi

    mkdir -p "$BACKUP_DIR"
    chmod 755 "$BACKUP_DIR"

    local timestamp
    timestamp=$(date +"%Y%m%d_%H%M%S")
    local filename
    filename=$(basename "$target_file")
    local backup_target="${BACKUP_DIR}/${filename}.${timestamp}.bak"
    local standard_bak="${target_file}.bak"

    # Copy to timestamped backup
    cp -p "$target_file" "$backup_target"
    # Copy to standard .bak file for backwards compatibility
    cp -p "$target_file" "$standard_bak"

    # Rotate old timestamped backups (keep MAX_BACKUPS_PER_REPO)
    # Null-delimited, mtime-sorted (safe for spaces/newlines; no ls parsing)
    local keep=$((MAX_BACKUPS_PER_REPO))
    local count=0
    while IFS= read -r -d '' old; do
        count=$((count + 1))
        if (( count > keep )); then
            rm -f "$old"
        fi
    done < <(find "$BACKUP_DIR" -maxdepth 1 -name "${filename}.*.bak" -type f -printf '%T@ %p\0' 2>/dev/null | sort -z -rn | cut -z -d' ' -f2- || true)

    echo "$backup_target"
}

restore_backups_menu() {
    print_banner
    log_step "Mirrorlist Restoration"

    if [[ ! -d "$BACKUP_DIR" ]] && ! compgen -G "${PACMAN_D}/*.bak" >/dev/null; then
        log_warn "No mirrorlist backups found in ${BACKUP_DIR} or ${PACMAN_D}."
        exit 0
    fi

    local backups=()
    # mtime-sorted, null-delimited (safe for spaces/newlines)
    while IFS= read -r -d '' file; do
        backups+=("$file")
    done < <(find "$BACKUP_DIR" "${PACMAN_D}" -maxdepth 1 -name "*mirrorlist*.bak*" -type f -printf '%T@ %p\0' 2>/dev/null | sort -z -rn | cut -z -d' ' -f2- || true)

    if [[ ${#backups[@]} -eq 0 ]]; then
        log_warn "No backups found."
        exit 0
    fi

    echo ""
    log_info "Found ${#backups[@]} available backup(s):"
    echo ""

    local h_idx; h_idx=$(repeat_char "${BOX_H}" 4)
    local h_repo; h_repo=$(repeat_char "${BOX_H}" 13)
    local h_file; h_file=$(repeat_char "${BOX_H}" 27)
    local h_date; h_date=$(repeat_char "${BOX_H}" 18)
    local h_size; h_size=$(repeat_char "${BOX_H}" 8)

    echo -e "  ${C_SURFACE1}${BOX_TL}${h_idx}${BOX_TJ}${h_repo}${BOX_TJ}${h_file}${BOX_TJ}${h_date}${BOX_TJ}${h_size}${BOX_TR}${C_RESET}"
    printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_LAVENDER}%-2s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_LAVENDER}%-11s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_LAVENDER}%-25s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_LAVENDER}%-16s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_LAVENDER}%-6s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" "#" "REPO" "BACKUP FILE" "DATE CREATED" "SIZE"
    echo -e "  ${C_SURFACE1}${BOX_LJ}${h_idx}${BOX_X}${h_repo}${BOX_X}${h_file}${BOX_X}${h_date}${BOX_X}${h_size}${BOX_RJ}${C_RESET}"

    local i=1
    for b in "${backups[@]}"; do
        local mtime
        mtime=$(stat -c '%y' "$b" 2>/dev/null | cut -d'.' -f1 || echo "unknown")
        local mtime_short="${mtime:0:16}"
        local size_bytes
        size_bytes=$(stat -c '%s' "$b" 2>/dev/null || echo "0")
        local size_fmt
        if (( size_bytes >= 1024 )); then
            size_fmt="$(( size_bytes / 1024 )) KB"
        else
            size_fmt="${size_bytes} B"
        fi

        local bname
        bname=$(basename "$b")
        local r_name="arch"
        for entry in "${REPO_CATALOG[@]}"; do
            IFS=':' read -r cat_id _sub cfile _max _desc <<< "$entry"
            if [[ "$bname" =~ ^${cfile} ]]; then
                r_name="$cat_id"
                break
            fi
        done

        local short_bname="$bname"
        if (( ${#short_bname} > 25 )); then
            short_bname="${short_bname:0:22}..."
        fi

        printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_MAUVE}%2d${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEXT}%-11s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_SUBTEXT1}%-25s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_OVERLAY0}%-16s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEAL}%6s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
            "$i" "$r_name" "$short_bname" "$mtime_short" "$size_fmt"
        i=$((i + 1))
    done

    echo -e "  ${C_SURFACE1}${BOX_BL}${h_idx}${BOX_BJ}${h_repo}${BOX_BJ}${h_file}${BOX_BJ}${h_date}${BOX_BJ}${h_size}${BOX_BR}${C_RESET}"

    echo ""
    local choice
    read -rp " Select backup number to restore (or 'q' to quit): " choice
    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#backups[@]} )); then
        local selected="${backups[$((choice - 1))]}"
        local filename
        filename=$(basename "$selected")

        # Validate backup looks like a mirrorlist before overwriting live file
        if ! grep -qE '^\s*Server\s*=' "$selected" 2>/dev/null; then
            log_error "Backup '${selected}' contains no 'Server =' lines — refusing to restore."
            exit 1
        fi
        
        # Determine target file
        local target_base="${filename%%.bak*}"
        local target="${PACMAN_D}/${target_base}"

        cp -p "$selected" "$target"
        chmod 644 "$target"
        chown root:root "$target" 2>/dev/null || true
        log_success "Restored ${selected} -> ${target}"
    else
        log_info "Restoration aborted."
    fi
    exit 0
}

