#!/usr/bin/env bash
# Ensure execution under bash even if invoked via `sh rank`
if [ -z "${BASH_VERSION:-}" ]; then
    exec bash "$0" "$@"
fi

# ==============================================================================
# rank - Modern, map-aware pacman mirror ranking & management utility
# ==============================================================================
# Description:
#   Automatically detects active Arch Linux and third-party repositories,
#   benchmarks mirrors via rate-mirrors with live terminal feedback,
#   safely performs atomic updates with timestamped backups, and provides
#   restoration and database synchronization.
#
# License: GPL-3.0. See LICENSE.

set -eo pipefail

SCRIPT_VERSION="2.2.0"
PACMAN_CONF="/etc/pacman.conf"
PACMAN_D="/etc/pacman.d"
BACKUP_DIR="${PACMAN_D}/backups"
MAX_BACKUPS_PER_REPO=5

# ------------------------------------------------------------------------------
# UI & Styling Configuration (Catppuccin Mocha Theme)
# ------------------------------------------------------------------------------
# Check color support
if [[ -t 1 ]] && [[ -z "${NO_COLOR:-}" ]] && [[ "${TERM:-}" != "dumb" ]]; then
    USE_COLOR=true
    C_RESET="\033[0m"
    C_BOLD="\033[1m"
    
    # Catppuccin Mocha Palette
    C_MAUVE="\033[38;2;203;166;247m"
    C_RED="\033[38;2;243;139;168m"
    C_PEACH="\033[38;2;250;179;135m"
    C_GREEN="\033[38;2;166;227;161m"
    C_TEAL="\033[38;2;148;226;213m"
    C_SAPPHIRE="\033[38;2;116;199;236m"
    C_LAVENDER="\033[38;2;180;190;254m"
    C_TEXT="\033[38;2;205;214;244m"
    C_SUBTEXT1="\033[38;2;186;194;222m"
    C_SUBTEXT0="\033[38;2;166;173;200m"
    C_OVERLAY1="\033[38;2;127;132;156m"
    C_OVERLAY0="\033[38;2;108;112;134m"
    C_SURFACE2="\033[38;2;88;91;112m"
    C_SURFACE1="\033[38;2;69;71;90m"
    BG_PEACH="\033[48;2;250;179;135m\033[38;2;17;17;27m"
else
    USE_COLOR=false
    C_RESET=""; C_BOLD=""
    C_MAUVE=""; C_RED=""; C_PEACH=""; C_GREEN=""
    C_TEAL=""; C_SAPPHIRE=""; C_LAVENDER=""; C_TEXT=""
    C_SUBTEXT1=""; C_SUBTEXT0=""; C_OVERLAY1=""; C_OVERLAY0=""
    C_SURFACE2=""; C_SURFACE1=""; BG_PEACH=""
fi

disable_color() {
    USE_COLOR=false
    C_RESET=""; C_BOLD=""
    C_MAUVE=""; C_RED=""; C_PEACH=""; C_GREEN=""
    C_TEAL=""; C_SAPPHIRE=""; C_LAVENDER=""; C_TEXT=""
    C_SUBTEXT1=""; C_SUBTEXT0=""; C_OVERLAY1=""; C_OVERLAY0=""
    C_SURFACE2=""; C_SURFACE1=""; BG_PEACH=""
}

# Temporary workspace directory
TMP_DIR=""
init_tmpdir() {
    TMP_DIR=$(mktemp -d -t rank.XXXXXX 2>/dev/null || mktemp -d /tmp/rank.XXXXXX)
}
cleanup_tmpfiles() {
    [[ -n "${TMP_DIR:-}" && -d "$TMP_DIR" ]] && rm -rf "$TMP_DIR" 2>/dev/null || true
}

# Unicode vs ASCII glyphs
# NOTE: log-line glyphs are deliberately chosen from single-cell codepoints
# (• ▲ ✔ ✖). No pictographic or multi-width emojis are used.
if [[ "${LANG:-}" =~ [Uu][Tt][Ff]-?8 ]]; then
    SYM_CHECK="✔"
    SYM_CROSS="✖"
    SYM_WARN="▲"
    SYM_INFO="•"
    SYM_ARROW="›"
    SYM_BULLET="•"

    # Modern rounded box-drawing
    BOX_TL="╭"
    BOX_TR="╮"
    BOX_BL="╰"
    BOX_BR="╯"
    BOX_H="─"
    BOX_V="│"
    BOX_TJ="┬"
    BOX_BJ="┴"
    BOX_LJ="├"
    BOX_RJ="┤"
    BOX_X="┼"
else
    SYM_CHECK="OK"
    SYM_CROSS="XX"
    SYM_WARN="!!"
    SYM_INFO="--"
    SYM_ARROW=">>"
    SYM_BULLET="*"

    # ASCII box-drawing
    BOX_TL="+"
    BOX_TR="+"
    BOX_BL="+"
    BOX_BR="+"
    BOX_H="-"
    BOX_V="|"
    BOX_TJ="+"
    BOX_BJ="+"
    BOX_LJ="+"
    BOX_RJ="+"
    BOX_X="+"
fi

# Repeat a character N times (pure bash, high performance)
repeat_char() {
    local char="$1" count="$2"
    (( count > 0 )) && printf "%0.s${char}" $(seq 1 "$count")
}

# Prominent Dry-Run Watermark Banner
print_dry_run_watermark() {
    if [[ "$FLAG_DRY_RUN" != true ]]; then
        return 0
    fi
    echo ""
    local badge=" DRY-RUN MODE "
    local msg="Benchmark active only. No mirrorlists will be modified."
    local inner=" ${badge} ${msg} "
    local inner_len=${#inner}
    local line_h
    line_h=$(repeat_char "${BOX_H}" "$inner_len")

    if [[ "$USE_COLOR" = true ]]; then
        echo -e "  ${C_PEACH}${BOX_TL}${line_h}${BOX_TR}${C_RESET}"
        echo -e "  ${C_PEACH}${BOX_V}${C_RESET} ${BG_PEACH}${badge}${C_RESET} ${C_BOLD}${C_PEACH}${msg}${C_RESET} ${C_PEACH}${BOX_V}${C_RESET}"
        echo -e "  ${C_PEACH}${BOX_BL}${line_h}${BOX_BR}${C_RESET}"
    else
        local line_dash
        line_dash=$(repeat_char "-" "$inner_len")
        echo "  +${line_dash}+"
        echo "  | [DRY-RUN MODE] ${msg} |"
        echo "  +${line_dash}+"
    fi
}

# Top Mirror Results Table
print_mirror_card() {
    local repo_id="$1"
    local top_mirror="$2"
    local top_speed="$3"
    local valid_servers="$4"
    local target_path="$5"
    local backup_path="$6"
    local duration="$7"
    local is_dry="$8"

    local col1_w=12
    local col2_w=56

    local h1; h1=$(repeat_char "${BOX_H}" $((col1_w + 2)))
    local h2; h2=$(repeat_char "${BOX_H}" $((col2_w + 2)))

    local title_repo="${repo_id}"
    [[ "$is_dry" = true ]] && title_repo="${repo_id} [DRY-RUN]"

    echo ""
    echo -e "  ${C_SURFACE1}${BOX_TL}${h1}${BOX_TJ}${h2}${BOX_TR}${C_RESET}"
    printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_LAVENDER}%-${col1_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_MAUVE}%-${col2_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
        "TOP MIRROR" "$title_repo"
    echo -e "  ${C_SURFACE1}${BOX_LJ}${h1}${BOX_X}${h2}${BOX_RJ}${C_RESET}"

    # Status row
    local stat_label="Ranked in ${duration}s (${valid_servers} mirrors configured)"
    local check_vis=2; [[ "$SYM_CHECK" == "OK" ]] && check_vis=3
    local stat_vis_len=$(( check_vis + ${#stat_label} ))
    local stat_pad_len=$(( col2_w - stat_vis_len ))
    local stat_pad=""
    (( stat_pad_len > 0 )) && stat_pad=$(repeat_char " " "$stat_pad_len")
    printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEXT}%-${col1_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_GREEN}${SYM_CHECK}${C_RESET} ${C_TEXT}%s${C_RESET}%s ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
        "Status" "$stat_label" "$stat_pad"

    # Fastest URL row
    if [[ -n "$top_mirror" ]]; then
        local u="$top_mirror"
        if (( ${#u} > col2_w )); then
            u="${u:0:$((col2_w - 3))}..."
        fi
        printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEXT}%-${col1_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEAL}%-${col2_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
            "Fastest" "$u"
    fi

    # Speed row
    if [[ -n "$top_speed" ]]; then
        printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEXT}%-${col1_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_BOLD}${C_GREEN}%-${col2_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
            "Speed" "$top_speed"
    fi

    # Output row
    local dest_display="$target_path"
    [[ "$is_dry" = true ]] && dest_display="${target_path} (dry-run: unchanged)"
    if (( ${#dest_display} > col2_w )); then
        dest_display="${dest_display:0:$((col2_w - 3))}..."
    fi
    local dest_color="${C_TEXT}"
    [[ "$is_dry" = true ]] && dest_color="${C_PEACH}"
    printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEXT}%-${col1_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${dest_color}%-${col2_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
        "Output" "$dest_display"

    # Backup row
    if [[ -n "$backup_path" ]]; then
        local bak_display="$backup_path"
        if (( ${#bak_display} > col2_w )); then
            bak_display="${bak_display:0:$((col2_w - 3))}..."
        fi
        printf "  ${C_SURFACE1}${BOX_V}${C_RESET} ${C_TEXT}%-${col1_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET} ${C_SUBTEXT0}%-${col2_w}s${C_RESET} ${C_SURFACE1}${BOX_V}${C_RESET}\n" \
            "Backup" "$bak_display"
    fi

    echo -e "  ${C_SURFACE1}${BOX_BL}${h1}${BOX_BJ}${h2}${BOX_BR}${C_RESET}"
}

# ------------------------------------------------------------------------------
# Supported Repository Definitions
# Format: repo_id:subcommand:mirrorlist_filename:default_max_mirrors:display_name
# ------------------------------------------------------------------------------
REPO_CATALOG=(
    "arch:arch:mirrorlist:20:Arch Linux Official (core, extra, multilib)"
    "chaotic-aur:chaotic-aur:chaotic-mirrorlist:10:Chaotic-AUR Prebuilt Repository"
    "archlinuxcn:archlinuxcn:archlinuxcn-mirrorlist:10:Arch Linux Chinese Community Repo"
    "endeavouros:endeavouros:endeavouros-mirrorlist:10:EndeavourOS Repository"
    "cachyos:cachyos:cachyos-mirrorlist:10:CachyOS Optimized Repositories"
    "blackarch:blackarch:blackarch-mirrorlist:10:BlackArch Security Repository"
    "arch4edu:arch4edu:arch4edu-mirrorlist:10:Arch4Edu Academic Repository"
    "artix:artix:artix-mirrorlist:10:Artix Linux Repositories"
    "arcolinux:arcolinux:arcolinux-mirrorlist:10:ArcoLinux Repositories"
    "manjaro:manjaro:mirrorlist:10:Manjaro Linux Repositories"
)

# Global configuration flags
FLAG_ALL=false
FLAG_DRY_RUN=false
FLAG_FAST=false
FLAG_YES=false
FLAG_SYNC=default
FLAG_NO_BACKUP=false
FLAG_RESTORE=false
FLAG_LIST=false
OPT_COUNTRY=""
OPT_MAX_MIRRORS=""
OPT_COMPLETION=""
TARGET_REPOS=()
# Width of the repo-id column in progress lines; sized per-run in main()
REPO_COL_WIDTH=4

# Track results for the final summary table
# Array of strings: "repo|status|file|count|top_speed|duration" (pipe-delimited: speed contains spaces/colons)
declare -a RUN_RESULTS=()

# ------------------------------------------------------------------------------
# Logging & Printing Utilities
# ------------------------------------------------------------------------------
print_banner() {
    local term_width
    term_width=$(tput cols 2>/dev/null || echo 80)
    [[ $term_width -gt 72 ]] && term_width=72

    echo ""
    if [[ "$USE_COLOR" = true ]]; then
        echo -e "  ${C_BOLD}${C_MAUVE}::${C_RESET} ${C_BOLD}${C_LAVENDER}rank ${C_RESET}${C_SUBTEXT0}v${SCRIPT_VERSION}${C_RESET} ${C_OVERLAY1}— Map-Aware Pacman Mirror Optimizer${C_RESET}"
        local rule_line
        rule_line=$(repeat_char '─' "$((term_width - 4))")
        echo -e "  ${C_SURFACE1}${rule_line}${C_RESET}"
    else
        echo "  :: rank v${SCRIPT_VERSION} - Map-Aware Pacman Mirror Optimizer"
        echo "  ----------------------------------------------------------------"
    fi
}

log_info() {
    # %-2s keeps the message column fixed whether the glyph is 1 or 2 cells wide.
    # %b (not %s) for the message: callers embed ${C_*} codes which must be
    # interpreted, matching the old echo -e behavior.
    printf '  %b%-2s%b %b%b%b\n' "${C_SAPPHIRE}" "${SYM_INFO}" "${C_RESET}" "${C_TEXT}" "$*" "${C_RESET}"
}

log_success() {
    printf '  %b%-2s%b %b%b%b\n' "${C_GREEN}" "${SYM_CHECK}" "${C_RESET}" "${C_TEXT}" "$*" "${C_RESET}"
}

log_warn() {
    printf '  %b%-2s%b %b%b%b\n' "${C_PEACH}" "${SYM_WARN}" "${C_RESET}" "${C_PEACH}" "$*" "${C_RESET}" >&2
}

log_error() {
    printf '  %b%-2s%b %b%b%b\n' "${C_RED}" "${SYM_CROSS}" "${C_RESET}" "${C_RED}" "$*" "${C_RESET}" >&2
}

log_step() {
    echo -e "\n  ${C_BOLD}${C_MAUVE}::${C_RESET} ${C_BOLD}${C_LAVENDER}$*${C_RESET}"
}

